{{!
    @template report_transcript/pdf

    The PDF body, written through TCPDF's writeHTML(). TCPDF understands a narrow HTML
    subset, so this is table-only markup with inline widths: no classes, no flex, no grid.
    It shares data with report_transcript/transcript but deliberately nothing else.

    Text values marked "HTML" have been escaped and wrapped in font spans by the renderer;
    they are printed unescaped on purpose.

    Context variables required for this template:
    * title - HTML
    * fullname - HTML
    * issuedon - formatted date
    * code - formatted verification code
    * verifyurl
    * hasrows, rows - array of {coursename (HTML), shortname (HTML), started, completed, gradetext, outcome}
    * showoutcome
    * coursewidth - percentage width of the course column, which absorbs the outcome column when hidden
    * emptytext

    Example context (json):
    {
        "title": "Academic transcript",
        "fullname": "Asha Rao",
        "issuedon": "14 September 2026",
        "code": "ABCD EFGH JKLM NPQR STUV WXYZ",
        "verifyurl": "https://example.com/report/transcript/verify.php?code=ABCDEFGHJKLMNPQRSTUVWXYZ",
        "hasrows": true,
        "rows": [
            {"coursename": "Biology 101", "shortname": "BIO101", "started": "3 March 2026",
             "completed": "28 June 2026", "gradetext": "82.00", "outcome": "Pass"}
        ],
        "showoutcome": true,
        "coursewidth": 40,
        "emptytext": "No courses to show yet."
    }
}}
<h1 style="font-size: 20pt; font-weight: bold; margin: 0 0 10pt 0;">{{{title}}}</h1>

<table cellpadding="3" style="width: 100%; font-size: 10pt;">
    <tr>
        <td style="width: 28%; color: #555555;">{{#str}} pdf:issuedto, report_transcript {{/str}}</td>
        <td style="width: 72%; font-weight: bold;">{{{fullname}}}</td>
    </tr>
    <tr>
        <td style="color: #555555;">{{#str}} pdf:issuedon, report_transcript {{/str}}</td>
        <td>{{issuedon}}</td>
    </tr>
    <tr>
        <td style="color: #555555;">{{#str}} pdf:code, report_transcript {{/str}}</td>
        <td style="font-family: courier; font-size: 10.5pt;">{{code}}</td>
    </tr>
</table>

<div style="height: 10pt;"></div>

{{#hasrows}}
<table cellpadding="4" style="width: 100%; font-size: 9.5pt; border-collapse: collapse;">
    <thead>
        <tr style="background-color: #eeeeee; font-weight: bold;">
            <th style="width: {{coursewidth}}%; border-bottom: 0.6pt solid #888888;">{{#str}} col:course, report_transcript {{/str}}</th>
            <th style="width: 17%; border-bottom: 0.6pt solid #888888;">{{#str}} col:started, report_transcript {{/str}}</th>
            <th style="width: 17%; border-bottom: 0.6pt solid #888888;">{{#str}} col:completed, report_transcript {{/str}}</th>
            <th style="width: 14%; text-align: right; border-bottom: 0.6pt solid #888888;">{{#str}} col:grade, report_transcript {{/str}}</th>
            {{#showoutcome}}
            <th style="width: 12%; border-bottom: 0.6pt solid #888888;">{{#str}} col:outcome, report_transcript {{/str}}</th>
            {{/showoutcome}}
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            <td style="width: {{coursewidth}}%; border-bottom: 0.3pt solid #cccccc;">{{{coursename}}}<br /><span style="font-size: 8pt; color: #666666;">{{{shortname}}}</span></td>
            <td style="width: 17%; border-bottom: 0.3pt solid #cccccc;">{{started}}</td>
            <td style="width: 17%; border-bottom: 0.3pt solid #cccccc;">{{completed}}</td>
            <td style="width: 14%; text-align: right; border-bottom: 0.3pt solid #cccccc;">{{gradetext}}</td>
            {{#showoutcome}}
            <td style="width: 12%; border-bottom: 0.3pt solid #cccccc;">{{outcome}}</td>
            {{/showoutcome}}
        </tr>
        {{/rows}}
    </tbody>
</table>
{{/hasrows}}
{{^hasrows}}
<p>{{emptytext}}</p>
{{/hasrows}}
